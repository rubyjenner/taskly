# คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit .env)
POSTGRES_USER=taskly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskly
JWT_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:5173
# ลิงก์หน้าเว็บ (ใช้สร้างลิงก์รีเซ็ตรหัสผ่าน)
APP_URL=http://localhost:5173
# true = คืนลิงก์รีเซ็ตใน response เพื่อทดลอง (ยังไม่มีระบบส่งอีเมล) ห้ามเปิดในระบบจริง
RESET_DEMO=true
# true = สร้างบัญชีทดลอง demo@taskly.app / Taskly2026 พร้อมงานตัวอย่างตอนเริ่มระบบ (รันซ้ำได้ ไม่ซ้ำซ้อน)
SEED_DEMO=true
